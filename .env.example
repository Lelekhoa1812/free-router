# Provider API keys are managed in the authenticated dashboard and encrypted in MongoDB.
JEV_TYPESAFE_API_KEY=

# Persistence and coordination
MONGO_DB_CONNECTION_STRING=
MONGODB_DB=freerouter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quota routing: observe records only; enforce rejects when configured limits are exhausted
QUOTA_MODE=observe
# Optional JSON override; see docs/QUOTA_ROUTING.md. Empty uses safe defaults.
QUOTA_CONFIG_JSON=

# Required server secrets: use independent random values, at least 32 bytes each
ADMIN_SESSION_SECRET=
STATE_ENCRYPTION_KEY=
PREVIOUS_STATE_ENCRYPTION_KEY=
CLIENT_KEY_HASH_SECRET=
CRON_SECRET=

# Email-delivered shared admin access password (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_USER=
SMTP_PASSWORD=

# Optional
VERCEL_URL=
